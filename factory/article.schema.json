{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pt.rentbikehanoi.com/factory/article.schema.json",
  "title": "Rascunho de artigo — Writer Contract v1",
  "description": "Formato de cada ficheiro _factory/inbox/PT-XXXX.json. Comprimentos, contagens e regras editoriais são verificados por scripts/qa-factory.mjs (ver factory/WRITER-CONTRACT.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "id",
    "slug",
    "title",
    "description",
    "h1",
    "summary",
    "key_points",
    "intro",
    "sections",
    "faq",
    "sources",
    "legal_note",
    "writer",
    "status"
  ],
  "properties": {
    "contract_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "id": {
      "type": "string",
      "description": "ID do tema na fila, ex.: PT-0068"
    },
    "slug": {
      "type": "string",
      "description": "Igual ao slug do tema no plano"
    },
    "title": {
      "type": "string",
      "description": "Título SEO, 30–65 caracteres (máximo 70)"
    },
    "description": {
      "type": "string",
      "description": "Meta descrição, 120–160 caracteres"
    },
    "h1": {
      "type": "string",
      "description": "Título visível, diferente do título SEO"
    },
    "summary": {
      "type": "string",
      "description": "Resposta direta à pergunta principal, 1–3 frases"
    },
    "key_points": {
      "type": "array",
      "description": "3 a 6 pontos-chave",
      "items": {
        "type": "string"
      }
    },
    "intro": {
      "type": "array",
      "description": "1 a 3 parágrafos de introdução",
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "description": "Pelo menos 4 secções H2",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "h2",
          "body"
        ],
        "properties": {
          "h2": {
            "type": "string"
          },
          "body": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "Parágrafo (suporta [texto](/url/), **destaque** e {{tokens}})"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "h3"
                  ],
                  "properties": {
                    "h3": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ul"
                  ],
                  "properties": {
                    "ul": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ol"
                  ],
                  "properties": {
                    "ol": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "checklist"
                  ],
                  "properties": {
                    "checklist": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "steps"
                  ],
                  "properties": {
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "title",
                          "text"
                        ],
                        "properties": {
                          "title": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "table"
                  ],
                  "properties": {
                    "table": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "caption",
                        "head",
                        "rows"
                      ],
                      "properties": {
                        "caption": {
                          "type": "string"
                        },
                        "head": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "rows": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "note",
                    "tone",
                    "title"
                  ],
                  "properties": {
                    "note": {
                      "type": "string"
                    },
                    "tone": {
                      "type": "string",
                      "enum": [
                        "info",
                        "warn"
                      ]
                    },
                    "title": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "component",
                    "category"
                  ],
                  "properties": {
                    "component": {
                      "type": "string",
                      "enum": [
                        "price-table",
                        "model-cards"
                      ]
                    },
                    "category": {
                      "type": "string",
                      "enum": [
                        "motas-semiautomaticas",
                        "scooters-automaticas",
                        "motas-50cc",
                        "motas-eletricas",
                        "bicicletas-eletricas"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "faq": {
      "type": "array",
      "description": "0 ou 2–8 perguntas reais; cada pergunta termina em ?",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "a"
        ],
        "properties": {
          "q": {
            "type": "string"
          },
          "a": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "IDs de site/sources.json ou fontes novas verificadas",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "description": "ID do registo site/sources.json"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "publisher",
              "url",
              "accessed"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "accessed": {
                "type": "string",
                "description": "AAAA-MM-DD"
              },
              "type": {
                "type": "string",
                "enum": [
                  "legal-database",
                  "official",
                  "news",
                  "manufacturer",
                  "business",
                  "reference"
                ],
                "description": "Tipo de fonte (recomendado; o QA exige fonte legal ou oficial quando o texto fala de leis, coimas ou carta de condução)."
              },
              "lang": {
                "type": "string",
                "description": "Língua da fonte, código ISO 639-1: pt, vi, en…"
              }
            }
          }
        ]
      }
    },
    "legal_note": {
      "type": "boolean",
      "description": "true quando o artigo trata de regras legais, seguros ou segurança"
    },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "claude",
            "external-ai"
          ]
        },
        "name": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "READY_FOR_QA"
      ]
    },
    "revision": {
      "type": "object",
      "description": "Só para atualizar um artigo já publicado (mesmo id e slug). Sem este campo, um id publicado é recusado.",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "description": "O que mudou e porquê (mínimo 20 caracteres), por exemplo: coimas atualizadas segundo o decreto em vigor; título reescrito por CTR baixo na Search Console."
        }
      }
    }
  }
}
